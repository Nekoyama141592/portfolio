---
import logoProd from '../assets/share_ai/logo_prod.png';
import postsImg from '../assets/share_ai/posts.jpg';
---

<section id="hero">
	<!-- Background Effects -->
	<div class="hero-bg">
		<div class="hero-orb hero-orb-1"></div>
		<div class="hero-orb hero-orb-2"></div>
		<div class="hero-orb hero-orb-3"></div>
		<div class="hero-grid"></div>
	</div>

	<div class="container hero-content">
		<div class="hero-text">
			<div class="hero-badge animate-fade-in">
				<img src={logoProd.src} alt="ShareAI Logo" class="hero-logo" width="36" height="36" />
				<span>ShareAI</span>
			</div>

			<h1 class="animate-fade-in animate-delay-1">
				AIプロンプトを、<br />
				<span class="gradient-text">みんなでシェア</span>しよう
			</h1>

			<p class="hero-description animate-fade-in animate-delay-2">
				ShareAIは、あなたのお気に入りのAIプロンプトをコミュニティと共有し、
				カスタムAIキャラクターとチャットできるモバイルアプリです。
			</p>

			<div class="hero-cta animate-fade-in animate-delay-3">
				<a href="#screenshots" class="btn-primary">
					<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<path d="M12 5v14M5 12l7 7 7-7"/>
					</svg>
					アプリを見る
				</a>
				<a href="#features" class="btn-secondary">
					機能を詳しく
				</a>
			</div>

			<div class="hero-stats animate-fade-in animate-delay-4">
				<div class="stat">
					<span class="stat-value gradient-text">2.2k+</span>
					<span class="stat-label">チャット数</span>
				</div>
				<div class="stat-divider"></div>
				<div class="stat">
					<span class="stat-value gradient-text">100+</span>
					<span class="stat-label">AIプロンプト</span>
				</div>
				<div class="stat-divider"></div>
				<div class="stat">
					<span class="stat-value gradient-text">Free</span>
					<span class="stat-label">無料で利用可能</span>
				</div>
			</div>
		</div>

		<div class="hero-visual animate-fade-in animate-delay-2">
			<div class="phone-mockup">
				<div class="phone-frame">
					<div class="phone-notch"></div>
					<img src={postsImg.src} alt="ShareAI アプリスクリーンショット" class="phone-screen" />
				</div>
				<div class="phone-glow"></div>
			</div>
		</div>
	</div>
</section>

<style>
	#hero {
		position: relative;
		min-height: 100vh;
		display: flex;
		align-items: center;
		overflow: hidden;
		padding: 80px 0 60px;
	}

	/* Background Effects */
	.hero-bg {
		position: absolute;
		inset: 0;
		z-index: 0;
		overflow: hidden;
	}

	.hero-orb {
		position: absolute;
		border-radius: 50%;
		filter: blur(100px);
		opacity: 0.3;
	}

	.hero-orb-1 {
		width: 600px;
		height: 600px;
		background: radial-gradient(circle, rgba(74, 222, 128, 0.3) 0%, transparent 70%);
		top: -200px;
		right: -100px;
		animation: float 8s ease-in-out infinite;
	}

	.hero-orb-2 {
		width: 400px;
		height: 400px;
		background: radial-gradient(circle, rgba(6, 182, 212, 0.2) 0%, transparent 70%);
		bottom: -100px;
		left: -100px;
		animation: float 10s ease-in-out infinite reverse;
	}

	.hero-orb-3 {
		width: 300px;
		height: 300px;
		background: radial-gradient(circle, rgba(16, 185, 129, 0.15) 0%, transparent 70%);
		top: 50%;
		left: 50%;
		transform: translate(-50%, -50%);
		animation: float 12s ease-in-out infinite;
	}

	.hero-grid {
		position: absolute;
		inset: 0;
		background-image:
			linear-gradient(rgba(74, 222, 128, 0.03) 1px, transparent 1px),
			linear-gradient(90deg, rgba(74, 222, 128, 0.03) 1px, transparent 1px);
		background-size: 60px 60px;
		mask-image: radial-gradient(ellipse 80% 70% at 50% 50%, black 30%, transparent 100%);
		-webkit-mask-image: radial-gradient(ellipse 80% 70% at 50% 50%, black 30%, transparent 100%);
	}

	.hero-content {
		position: relative;
		z-index: 1;
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 60px;
		align-items: center;
	}

	/* Text Side */
	.hero-badge {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		background: rgba(74, 222, 128, 0.08);
		border: 1px solid rgba(74, 222, 128, 0.2);
		border-radius: 50px;
		padding: 8px 20px 8px 8px;
		margin-bottom: 28px;
		font-size: 0.9rem;
		font-weight: 600;
		color: var(--color-accent-green);
		letter-spacing: 0.02em;
	}

	.hero-logo {
		border-radius: 10px;
	}

	h1 {
		font-size: clamp(2.4rem, 5vw, 3.6rem);
		font-weight: 800;
		line-height: 1.2;
		margin-bottom: 24px;
		letter-spacing: -0.02em;
	}

	.hero-description {
		font-size: 1.1rem;
		color: var(--color-text-secondary);
		line-height: 1.8;
		margin-bottom: 36px;
		max-width: 500px;
	}

	.hero-cta {
		display: flex;
		gap: 16px;
		margin-bottom: 48px;
	}

	.btn-primary {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		padding: 14px 32px;
		background: linear-gradient(135deg, var(--color-accent-green-dark) 0%, var(--color-accent-emerald) 100%);
		color: #0d1117;
		font-weight: 700;
		font-size: 0.95rem;
		border-radius: 14px;
		transition: all var(--transition-medium);
		box-shadow: 0 4px 20px rgba(74, 222, 128, 0.25);
	}

	.btn-primary:hover {
		transform: translateY(-2px);
		box-shadow: 0 8px 30px rgba(74, 222, 128, 0.4);
	}

	.btn-secondary {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		padding: 14px 32px;
		background: transparent;
		color: var(--color-text-primary);
		font-weight: 600;
		font-size: 0.95rem;
		border: 1px solid var(--color-border);
		border-radius: 14px;
		transition: all var(--transition-medium);
	}

	.btn-secondary:hover {
		border-color: var(--color-border-hover);
		background: rgba(74, 222, 128, 0.05);
		transform: translateY(-2px);
	}

	/* Stats */
	.hero-stats {
		display: flex;
		align-items: center;
		gap: 24px;
	}

	.stat {
		display: flex;
		flex-direction: column;
		gap: 2px;
	}

	.stat-value {
		font-size: 1.5rem;
		font-weight: 800;
	}

	.stat-label {
		font-size: 0.8rem;
		color: var(--color-text-muted);
		font-weight: 500;
	}

	.stat-divider {
		width: 1px;
		height: 36px;
		background: rgba(74, 222, 128, 0.15);
	}

	/* Phone Mockup */
	.hero-visual {
		display: flex;
		justify-content: center;
		align-items: center;
	}

	.phone-mockup {
		position: relative;
		animation: float 6s ease-in-out infinite;
	}

	.phone-frame {
		position: relative;
		width: 280px;
		border-radius: 36px;
		overflow: hidden;
		border: 3px solid rgba(74, 222, 128, 0.2);
		background: var(--color-bg-secondary);
		box-shadow:
			0 25px 80px rgba(0, 0, 0, 0.5),
			inset 0 0 0 1px rgba(255, 255, 255, 0.05);
	}

	.phone-notch {
		position: absolute;
		top: 0;
		left: 50%;
		transform: translateX(-50%);
		width: 120px;
		height: 24px;
		background: #0d1117;
		border-radius: 0 0 16px 16px;
		z-index: 2;
	}

	.phone-screen {
		width: 100%;
		display: block;
	}

	.phone-glow {
		position: absolute;
		inset: -20px;
		border-radius: 50px;
		background: radial-gradient(
			circle at center,
			rgba(74, 222, 128, 0.12) 0%,
			transparent 70%
		);
		z-index: -1;
		animation: pulse-glow 4s ease-in-out infinite;
	}

	/* Responsive */
	@media screen and (max-width: 900px) {
		.hero-content {
			grid-template-columns: 1fr;
			text-align: center;
			gap: 48px;
		}

		.hero-description {
			max-width: 100%;
			margin-left: auto;
			margin-right: auto;
		}

		.hero-badge {
			justify-content: center;
		}

		.hero-cta {
			justify-content: center;
			flex-wrap: wrap;
		}

		.hero-stats {
			justify-content: center;
		}

		.hero-visual {
			order: -1;
		}

		.phone-frame {
			width: 240px;
		}
	}

	@media screen and (max-width: 480px) {
		h1 {
			font-size: 2rem;
		}

		.hero-cta {
			flex-direction: column;
			align-items: center;
		}

		.btn-primary,
		.btn-secondary {
			width: 100%;
			max-width: 280px;
			justify-content: center;
		}
	}
</style>
