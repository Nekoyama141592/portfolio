---
import chatImg from '../assets/share_ai/chat.jpg';
import postsImg from '../assets/share_ai/posts.jpg';
import profileImg from '../assets/share_ai/profile.jpg';
import usersImg from '../assets/share_ai/users.jpg';

const screenshots = [
	{ src: postsImg.src, alt: '人気の投稿一覧', label: '人気の投稿' },
	{ src: chatImg.src, alt: 'AIチャット画面', label: 'AIチャット' },
	{ src: usersImg.src, alt: 'ユーザーランキング', label: 'ランキング' },
	{ src: profileImg.src, alt: 'プロフィール画面', label: 'プロフィール' },
];
---

<section id="screenshots">
	<div class="container">
		<div class="section-header">
			<span class="section-label">Screenshots</span>
			<h2>アプリの<span class="gradient-text">スクリーンショット</span></h2>
			<p class="section-description">
				ShareAIの美しいダークテーマUIをご覧ください。
			</p>
		</div>

		<div class="screenshots-track">
			{screenshots.map((screenshot) => (
				<div class="screenshot-item">
					<div class="screenshot-phone">
						<div class="screenshot-notch"></div>
						<img src={screenshot.src} alt={screenshot.alt} loading="lazy" />
					</div>
					<span class="screenshot-label">{screenshot.label}</span>
				</div>
			))}
		</div>
	</div>
</section>

<style>
	#screenshots {
		padding: var(--section-padding);
		position: relative;
		overflow: hidden;
	}

	#screenshots::before {
		content: '';
		position: absolute;
		top: 50%;
		left: 50%;
		transform: translate(-50%, -50%);
		width: 800px;
		height: 800px;
		background: radial-gradient(circle, rgba(74, 222, 128, 0.06) 0%, transparent 70%);
		pointer-events: none;
	}

	.section-header {
		text-align: center;
		margin-bottom: 64px;
	}

	.section-label {
		display: inline-block;
		font-size: 0.8rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.15em;
		color: var(--color-accent-green);
		background: rgba(74, 222, 128, 0.08);
		border: 1px solid rgba(74, 222, 128, 0.15);
		padding: 6px 16px;
		border-radius: 50px;
		margin-bottom: 20px;
	}

	h2 {
		font-size: clamp(1.8rem, 4vw, 2.8rem);
		font-weight: 800;
		margin-bottom: 16px;
		letter-spacing: -0.02em;
	}

	.section-description {
		font-size: 1.05rem;
		color: var(--color-text-secondary);
		max-width: 560px;
		margin: 0 auto;
		line-height: 1.8;
	}

	.screenshots-track {
		display: flex;
		gap: 32px;
		justify-content: center;
		flex-wrap: wrap;
	}

	.screenshot-item {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 16px;
	}

	.screenshot-phone {
		position: relative;
		width: 220px;
		border-radius: 28px;
		overflow: hidden;
		border: 2px solid rgba(74, 222, 128, 0.15);
		background: var(--color-bg-secondary);
		box-shadow:
			0 20px 60px rgba(0, 0, 0, 0.4),
			inset 0 0 0 1px rgba(255, 255, 255, 0.03);
		transition: all var(--transition-medium);
	}

	.screenshot-phone:hover {
		border-color: rgba(74, 222, 128, 0.35);
		transform: translateY(-8px) scale(1.02);
		box-shadow:
			0 30px 80px rgba(0, 0, 0, 0.5),
			0 0 40px rgba(74, 222, 128, 0.1);
	}

	.screenshot-notch {
		position: absolute;
		top: 0;
		left: 50%;
		transform: translateX(-50%);
		width: 90px;
		height: 18px;
		background: #0d1117;
		border-radius: 0 0 12px 12px;
		z-index: 2;
	}

	.screenshot-phone img {
		width: 100%;
		display: block;
	}

	.screenshot-label {
		font-size: 0.85rem;
		font-weight: 600;
		color: var(--color-text-secondary);
		letter-spacing: 0.02em;
	}

	@media screen and (max-width: 900px) {
		.screenshots-track {
			gap: 24px;
		}

		.screenshot-phone {
			width: 180px;
		}
	}

	@media screen and (max-width: 480px) {
		.screenshots-track {
			display: grid;
			grid-template-columns: repeat(2, 1fr);
			gap: 16px;
			max-width: 380px;
			margin: 0 auto;
		}

		.screenshot-phone {
			width: 100%;
		}
	}
</style>
